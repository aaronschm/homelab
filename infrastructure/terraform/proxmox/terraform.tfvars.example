# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
# Real secrets must NEVER be committed (see ../../../.gitignore).

pve_endpoint  = "https://10.10.20.2:8006/"
# API token format: USER@REALM!TOKENID=UUID
# Combine the user/realm, your token name, and the secret UUID, e.g.
#   "root@pam!homelab=<YOUR-TOKEN-UUID>"   (or use a dedicated terraform user).
# Put the REAL value in terraform.tfvars (git-ignored), never here.
# Rotate any token whose UUID has been shared in plaintext.
pve_api_token = "root@pam!homelab=00000000-0000-0000-0000-000000000000"
pve_insecure  = true
pve_node      = "pve"

# Storage pools on this node:
#   beta  = 1TB ext4 SSD -> VM disks + LXC rootfs (fast, good for etcd)
#   local = directory storage at /var/lib/vz -> ISOs + cloud-init snippets
#   gamma = (future) the 6 MinIO drives, passed through raw to the worker VM
vm_storage     = "beta"
ct_storage     = "beta"
image_storage  = "local"
network_bridge = "vmbr0"

ssh_public_keys = [
  "ssh-ed25519 AAAA... you@admin",
]

# Talos image from the factory schematic below. Schematic includes:
#   qemu-guest-agent + iscsi-tools + util-linux-tools (the latter two are
#   REQUIRED by Longhorn). The schematic ID is content-addressed (deterministic)
#   and NOT a secret. Regenerate any time:
#     curl -X POST --data-binary @schematic.yaml \
#       https://factory.talos.dev/schematics    (see docs/proxmox-iac.md)
talos_version   = "v1.13.4"
talos_image_url = "https://factory.talos.dev/image/53513e54bb39202f35694412577a6bc53d484744d35a126e5d42ef34785c0d83/v1.13.4/nocloud-amd64.raw.gz"

# Debian 13 (trixie) LXC template — already on the node as:
lxc_template = "local:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst"
lxc_password = "change-me-then-rotate"

controlplanes = {
  "25011" = { vmid = 25011, ip = "10.10.25.11/24", cores = 2, memory = 6144, disk_gb = 50 }
}

workers = {
  "25101" = { vmid = 25101, ip = "10.10.25.101/24", cores = 6, memory = 32768, disk_gb = 100 }
}

# Worker data disks (attached scsi1, scsi2, ... in this order).
#   - Longhorn lives on the beta SSD, mounted at /var/mnt/longhorn (default
#     StorageClass; replica count 1 on the single worker).
#   - MinIO uses the interim 'alpha' pool (1000 GB for now) mounted at
#     /var/mnt/alpha via local-path. When the 6x18TB gamma drives are installed,
#     swap MinIO's backing store (raw passthrough) -- pods only see the S3
#     endpoint, so no app changes. Keep this list IDENTICAL in the talos module.
worker_data_disks = [
  { storage = "beta", size_gb = 400, mountpoint = "/var/mnt/longhorn" },
  { storage = "alpha", size_gb = 1000, mountpoint = "/var/mnt/alpha" },
]

# The 6x18TB MinIO drives are NOT installed yet. When they are, prefer RAW disk
# passthrough to the worker VM (qm set 25101 -scsiN /dev/disk/by-id/...) over
# wrapping each in a Proxmox 'gamma' storage pool -- avoids ZFS-on-ZFS overhead
# and lets MinIO do its own erasure coding. See docs/proxmox-iac.md.
minio_disks_by_id = []

lxcs = {
  "20101" = { vmid = 20101, ip = "10.10.20.101/24", vlan_key = "mgmt", cores = 1, memory = 2048, disk_gb = 50 }
  "24010" = { vmid = 24010, ip = "10.10.24.10/24", vlan_key = "dmz", cores = 1, memory = 1024, disk_gb = 8 }
}

# Pelican Wings gameserver host: Debian + Docker on the beta SSD (200 GB).
# Lives in the DMZ (VLAN 24) so games are reachable and Docker can pull images.
# The Pelican Panel (web UI) runs in Kubernetes; back game data up to MinIO.
gameservers = {}
