# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

cluster_name       = "isarcloud"
# Single control plane: leave cluster_vip empty (no kube-vip needed).
cluster_vip        = ""
kubernetes_version = "v1.34.1"
talos_version      = "v1.13.4"
install_disk       = "/dev/sda"

# Worker data disks (scsi1, scsi2, ... in order). MUST match the proxmox module.
# Talos formats + mounts each at .mountpoint and bind-mounts it into the kubelet.
#   scsi1 -> /dev/sdb -> /var/mnt/longhorn (Longhorn, on beta)
#   scsi2 -> /dev/sdc -> /var/mnt/alpha    (MinIO/local-path, on alpha)
worker_data_disks = [
  { storage = "beta", size_gb = 400, mountpoint = "/var/mnt/longhorn" },
  { storage = "alpha", size_gb = 1000, mountpoint = "/var/mnt/alpha" },
]

# Registry LXC acting as a pull-through mirror for the dark Cluster VLAN.
registry_mirror_endpoint = "http://10.10.20.101:5000"

controlplane_nodes = {
  "25011" = "10.10.25.11"
}

worker_nodes = {
  "25101" = "10.10.25.101"
}
