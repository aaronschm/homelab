# Secrets / env
.env

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Talos / Kubernetes credentials
talosconfig
kubeconfig
*.kubeconfig

# Ansible secrets (UDM creds, vault)
# all.sops.yaml is the SOPS-encrypted version tracked in git.
# all.yml (plaintext fallback) must never be committed.
ansible/group_vars/all.yml
*.vault.yml

# Real Kubernetes secrets — commit only the *.example.yaml templates.
# (Seal real secrets with kubeseal for GitOps, or apply via `make secrets`.)
kubernetes/**/!*.sops.yaml
*.sops.yaml
_local/
!kubernetes/**/*-secret.example.yaml
!kubernetes/**/sealed-*.yaml
!*.sops.yaml
_local/
