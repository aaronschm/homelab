{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "/var/lib/zot",
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5001"
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://registry-1.docker.io"],
          "content": [
            { "prefix": "library/**" },
            { "prefix": "simplexchat/**" },
            { "prefix": "rustdesk/**" },
            { "prefix": "docker.io/**", "stripPrefix": true }
          ],
          "onDemand": false,
          "tlsVerify": true,
          "pollInterval": "6h"
        },
        {
          "urls": ["https://ghcr.io"],
          "content": [
            { "prefix": "siderolabs/**" },
            { "prefix": "dexidp/**" },
            { "prefix": "goauthentik/**" },
            { "prefix": "paperless-ngx/**" },
            { "prefix": "ghcr.io/**", "stripPrefix": true }
          ],
          "onDemand": false,
          "tlsVerify": true,
          "pollInterval": "6h"
        },
        {
          "urls": ["https://registry.k8s.io"],
          "content": [
            { "prefix": "kube-*" },
            { "prefix": "etcd" },
            { "prefix": "pause" },
            { "prefix": "coredns/**" },
            { "prefix": "registry.k8s.io/**", "stripPrefix": true }
          ],
          "onDemand": false,
          "tlsVerify": true,
          "pollInterval": "6h"
        },
        {
          "urls": ["https://quay.io"],
          "content": [
            { "prefix": "cilium/**" },
            { "prefix": "argoproj/**" },
            { "prefix": "quay.io/**", "stripPrefix": true }
          ],
          "onDemand": false,
          "tlsVerify": true,
          "pollInterval": "6h"
        },
        {
          "urls": ["https://public.ecr.aws"],
          "content": [
            { "prefix": "docker/library/**" },
            { "prefix": "public.ecr.aws/**", "stripPrefix": true }
          ],
          "onDemand": false,
          "tlsVerify": true,
          "pollInterval": "6h"
        }
      ]
    }
  }
}
