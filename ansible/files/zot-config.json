{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "/var/lib/zot",
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000"
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://registry-1.docker.io"],
          "content": [{ "prefix": "docker/library/**" }],
          "onDemand": false,
          "tlsVerify": true
        },
        {
          "urls": ["https://ghcr.io"],
          "content": [
            { "prefix": "siderolabs/**" },
            { "prefix": "dexidp/**" }
          ],
          "onDemand": false,
          "tlsVerify": true
        },
        {
          "urls": ["https://registry.k8s.io"],
          "content": [
            { "prefix": "kube-*" },
            { "prefix": "etcd" },
            { "prefix": "pause" },
            { "prefix": "coredns/**" }
          ],
          "onDemand": false,
          "tlsVerify": true
        },
        {
          "urls": ["https://quay.io"],
          "content": [
            { "prefix": "cilium/**" },
            { "prefix": "argoproj/**" }
          ],
          "onDemand": false,
          "tlsVerify": true
        },
        {
          "urls": ["https://public.ecr.aws"],
          "content": [{ "prefix": "docker/library/**" }],
          "onDemand": false,
          "tlsVerify": true
        }
      ]
    }
  }
}
